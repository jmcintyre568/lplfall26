AWS_REGION=us-west-2
# Use a named profile (including an IAM Identity Center SSO profile) when desired.
AWS_PROFILE=briefly

# Optional: enable an already-created, versioned Amazon Bedrock Guardrail.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Optional: enable searches of an already-created and ingested Bedrock Knowledge Base.
BEDROCK_KNOWLEDGE_BASE_ID=

# Keep credentials in the AWS CLI credential chain / IAM Identity Center, never here.
